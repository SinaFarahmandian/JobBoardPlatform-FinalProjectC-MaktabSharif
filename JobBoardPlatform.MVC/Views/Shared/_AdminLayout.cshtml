@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17162b" />
    <title>@ViewData["Title"] | CareerWay Admin</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/sb-admin-2/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar" id="adminSidebar" aria-label="Administration menu">
        <div class="admin-sidebar-head">
            <a class="brand admin-brand" asp-controller="AdminDashboard" asp-action="Index">
                <span class="brand-mark"><i class="fas fa-briefcase"></i></span>
                <span>Career<span>Way</span></span>
            </a>
            <button type="button" class="admin-sidebar-close d-lg-none" data-admin-sidebar aria-label="Close menu">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="admin-caption">Administration</div>
        <nav class="admin-nav">
            <a class="@(currentController == "AdminDashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Index">
                <span><i class="fas fa-th-large"></i></span> Overview
            </a>
            <a class="@(currentController == "AdminEmployers" ? "active" : "")" asp-controller="AdminEmployers" asp-action="Index">
                <span><i class="fas fa-building"></i></span> Employers
            </a>
            <a class="@(currentController == "AdminJobSeekers" ? "active" : "")" asp-controller="AdminJobSeekers" asp-action="Index">
                <span><i class="fas fa-users"></i></span> Job Seekers
            </a>
            <a class="@(currentController == "AdminJobPostings" ? "active" : "")" asp-controller="AdminJobPostings" asp-action="Index">
                <span><i class="fas fa-briefcase"></i></span> Job Postings
            </a>
            <a class="@(currentController == "AdminEmailTemplates" ? "active" : "")" asp-controller="AdminEmailTemplates" asp-action="Index">
                <span><i class="fas fa-envelope"></i></span> Email Templates
            </a>
        </nav>

        <div class="admin-sidebar-footer">
            <a asp-controller="Public" asp-action="Index"><i class="fas fa-external-link-alt"></i> View Website</a>
            <small>CareerWay Admin</small>
        </div>
    </aside>

    <div class="admin-overlay" data-admin-sidebar></div>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-title">
                <button class="admin-menu-button d-lg-none" type="button" data-admin-sidebar aria-label="Open menu">
                    <i class="fas fa-bars"></i>
                </button>
                <div>
                    <small>Admin Panel</small>
                    <strong>@ViewData["Title"]</strong>
                </div>
            </div>
            <div class="admin-account dropdown">
                <button type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-avatar">@((User.Identity?.Name ?? "A").Substring(0, 1).ToUpperInvariant())</span>
                    <span><small>Administrator</small><strong>@User.Identity?.Name</strong></span>
                    <i class="fas fa-chevron-down"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                    <li><a class="dropdown-item" asp-controller="Public" asp-action="Index"><i class="fas fa-home"></i> Back to Website</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="dropdown-item text-danger" type="submit"><i class="fas fa-sign-out-alt"></i> Sign Out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        @if (TempData["Success"] != null || TempData["Error"] != null)
        {
            <div class="flash-stack" aria-live="polite">
                @if (TempData["Success"] != null)
                {
                    <div class="flash-message flash-success">
                        <span class="flash-icon"><i class="fas fa-check"></i></span>
                        <div><strong>Success</strong><span>@TempData["Success"]</span></div>
                        <button type="button" data-flash-close aria-label="Dismiss"><i class="fas fa-times"></i></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="flash-message flash-error">
                        <span class="flash-icon"><i class="fas fa-exclamation"></i></span>
                        <div><strong>Error</strong><span>@TempData["Error"]</span></div>
                        <button type="button" data-flash-close aria-label="Dismiss"><i class="fas fa-times"></i></button>
                    </div>
                }
            </div>
        }

        <main class="admin-content" id="main-content">
            @RenderBody()
        </main>

        <footer class="admin-footer">
            <span>© @DateTime.Now.Year CareerWay</span>
            <span>Unified job platform administration</span>
        </footer>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/vendor/sb-admin-2/vendor/chart.js/Chart.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
