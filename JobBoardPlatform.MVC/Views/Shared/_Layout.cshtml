@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CareerWay helps talented people discover trusted jobs and build better careers." />
    <meta name="theme-color" content="#5b4df7" />
    <title>@ViewData["Title"] | CareerWay</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/sb-admin-2/vendor/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"] ?? string.Empty)">
<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="site-header">
    <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
        <div class="container site-nav-container">
            <a class="navbar-brand brand" asp-controller="Public" asp-action="Index" aria-label="CareerWay home">
                <span class="brand-mark"><i class="fas fa-briefcase" aria-hidden="true"></i></span>
                <span>Career<span>Way</span></span>
            </a>

            <button class="navbar-toggler site-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Open navigation menu">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav main-nav">
                    <a class="nav-link @(currentController == "Public" ? "active" : "")" asp-controller="Public" asp-action="Index">
                        Find Jobs
                    </a>

                    @if (User.IsInRole("JobSeeker"))
                    {
                        <a class="nav-link @(currentController == "JobSeekerApplications" ? "active" : "")"
                           asp-controller="JobSeekerApplications" asp-action="Index">My Applications</a>
                        <a class="nav-link @(currentController == "JobSeekerProfile" ? "active" : "")"
                           asp-controller="JobSeekerProfile" asp-action="Index">Career Profile</a>
                    }

                    @if (User.IsInRole("Employer"))
                    {
                        <a class="nav-link @(currentController == "EmployerJobPostings" ? "active" : "")"
                           asp-controller="EmployerJobPostings" asp-action="Index">Manage Jobs</a>
                        <a class="nav-link @(currentController == "Company" ? "active" : "")"
                           asp-controller="Company" asp-action="Index">Company Profile</a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">Admin Panel</a>
                    }
                </div>

                <div class="navbar-nav auth-nav">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="user-avatar">@((User.Identity?.Name ?? "U").Substring(0, 1).ToUpperInvariant())</span>
                                <span class="user-menu-copy">
                                    <small>Welcome</small>
                                    <strong>@User.Identity?.Name</strong>
                                </span>
                                <i class="fas fa-chevron-down" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                                @if (User.IsInRole("JobSeeker"))
                                {
                                    <li><a class="dropdown-item" asp-controller="JobSeekerProfile" asp-action="Index"><i class="fas fa-user"></i> My Profile</a></li>
                                }
                                @if (User.IsInRole("Employer"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Company" asp-action="Index"><i class="fas fa-building"></i> My Company</a></li>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index"><i class="fas fa-cog"></i> Platform Admin</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt"></i> Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Sign In</a>
                        <a class="btn btn-primary btn-nav" asp-controller="Account" asp-action="RegisterJobSeeker">Create Account</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

@if (TempData["Success"] != null || TempData["Error"] != null)
{
    <div class="flash-stack" aria-live="polite">
        @if (TempData["Success"] != null)
        {
            <div class="flash-message flash-success" role="status">
                <span class="flash-icon"><i class="fas fa-check"></i></span>
                <div><strong>Success</strong><span>@TempData["Success"]</span></div>
                <button type="button" data-flash-close aria-label="Dismiss message"><i class="fas fa-times"></i></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flash-message flash-error" role="alert">
                <span class="flash-icon"><i class="fas fa-exclamation"></i></span>
                <div><strong>Error</strong><span>@TempData["Error"]</span></div>
                <button type="button" data-flash-close aria-label="Dismiss message"><i class="fas fa-times"></i></button>
            </div>
        }
    </div>
}

<main id="main-content" class="site-main">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="brand footer-brand" asp-controller="Public" asp-action="Index">
                    <span class="brand-mark"><i class="fas fa-briefcase"></i></span>
                    <span>Career<span>Way</span></span>
                </a>
                <p>A shorter path between talented people and the teams building tomorrow.</p>
            </div>
            <div>
                <h6>For Job Seekers</h6>
                <a asp-controller="Public" asp-action="Index">Explore Jobs</a>
                <a asp-controller="Account" asp-action="RegisterJobSeeker">Create a Profile</a>
            </div>
            <div>
                <h6>For Employers</h6>
                <a asp-controller="Account" asp-action="RegisterEmployer">Register a Company</a>
                <a asp-controller="EmployerJobPostings" asp-action="Index">Manage Jobs</a>
            </div>
            <div>
                <h6>Quick Links</h6>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a href="mailto:support@careerway.local">Support</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year CareerWay. All rights reserved.</span>
            <span>Built for a better career start</span>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
