<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پلتفرم کاریابی</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Public" asp-action="Index">
            <i class="bi bi-briefcase-fill"></i> پلتفرم کاریابی
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <div class="navbar-nav me-auto">
                @if (User.IsInRole("JobSeeker"))
                {
                    <a class="nav-link" asp-controller="JobSeekerProfile" asp-action="Index"><i class="bi bi-person-circle"></i> پروفایل من</a>
                    <a class="nav-link" asp-controller="JobSeekerApplications" asp-action="Index"><i class="bi bi-send"></i> درخواست‌های من</a>
                }
                @if (User.IsInRole("Employer"))
                {
                    <a class="nav-link" asp-controller="Company" asp-action="Index"><i class="bi bi-building"></i> شرکت من</a>
                    <a class="nav-link" asp-controller="EmployerJobPostings" asp-action="Index"><i class="bi bi-file-earmark-text"></i> آگهی‌های من</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" asp-controller="AdminDashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> پنل ادمین</a>
                }
            </div>
            <div class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-link text-white"><i class="bi bi-person-fill"></i> @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link nav-link"><i class="bi bi-box-arrow-left"></i> خروج</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> ورود</a>
                    <a class="nav-link" asp-controller="Account" asp-action="RegisterJobSeeker">ثبت‌نام کارجو</a>
                    <a class="nav-link" asp-controller="Account" asp-action="RegisterEmployer">ثبت‌نام کارفرما</a>
                }
            </div>
        </div>
    </div>
</nav>
<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div>
    }
    @RenderBody()
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>