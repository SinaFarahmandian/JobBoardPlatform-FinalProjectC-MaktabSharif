<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - پلتفرم کاریابی</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Public" asp-action="Index">پلتفرم کاریابی</a>
        <div class="navbar-nav me-auto">
            @if (User.IsInRole("JobSeeker"))
            {
                <a class="nav-link" asp-controller="JobSeekerProfile" asp-action="Index">پروفایل من</a>
                <a class="nav-link" asp-controller="JobSeekerApplications" asp-action="Index">درخواست‌های من</a>
            }
            @if (User.IsInRole("Employer"))
            {
                <a class="nav-link" asp-controller="Company" asp-action="Index">شرکت من</a>
                <a class="nav-link" asp-controller="EmployerJobPostings" asp-action="Index">آگهی‌های من</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">داشبورد ادمین</a>
                <a class="nav-link" asp-controller="AdminEmployers" asp-action="Index">مدیریت کارفرماها</a>
                <a class="nav-link" asp-controller="AdminJobSeekers" asp-action="Index">مدیریت کارجوها</a>
                <a class="nav-link" asp-controller="AdminJobPostings" asp-action="Index">مدیریت آگهی‌ها</a>
            }
        </div>
        <div class="navbar-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="nav-link text-white">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link nav-link">خروج</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-controller="Account" asp-action="Login">ورود</a>
                <a class="nav-link" asp-controller="Account" asp-action="RegisterJobSeeker">ثبت‌نام کارجو</a>
                <a class="nav-link" asp-controller="Account" asp-action="RegisterEmployer">ثبت‌نام کارفرما</a>
            }
        </div>
    </div>
</nav>
<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</div>
</body>
</html>