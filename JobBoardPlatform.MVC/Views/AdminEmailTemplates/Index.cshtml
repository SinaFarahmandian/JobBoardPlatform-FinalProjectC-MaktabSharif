@model List<EmailTemplateDto>
@{
    ViewData["Title"] = "قالب‌های ایمیل";
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr><th>کلید</th><th>موضوع</th><th>فعال</th><th></th></tr></thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Key</td>
                    <td>@t.Subject</td>
                    <td>
                        @if (t.IsEnabled)
                        {
                            <span class="badge bg-success">بله</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">خیر</span>
                        }
                    </td>
                    <td><a asp-action="Edit" asp-route-key="@t.Key" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i> ویرایش</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>