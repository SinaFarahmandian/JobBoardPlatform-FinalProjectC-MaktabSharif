@model List<EmailTemplateDto>
@{ ViewData["Title"] = "Email Templates"; Layout = "_AdminLayout"; }
<div class="admin-page-head"><div><h1>Email Templates</h1><p>Notification content sent to users at key stages.</p></div></div>
<section class="admin-card no-padding">
    <div class="admin-table-toolbar"><span class="admin-table-toolbar-copy">@Model.Count message templates configured.</span></div>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead><tr><th>Template</th><th>Subject</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><div class="admin-person"><span class="admin-person-avatar"><i class="fas fa-envelope"></i></span><span class="admin-person-copy"><strong>@item.Key</strong><small>System template key</small></span></div></td>
                        <td>@item.Subject</td>
                        <td><span class="badge-soft @(item.IsEnabled ? "badge-success" : "badge-neutral")">@(item.IsEnabled ? "Enabled" : "Disabled")</span></td>
                        <td><div class="admin-actions"><a asp-action="Edit" asp-route-key="@item.Key" class="btn btn-soft-primary"><i class="fas fa-pen me-1"></i> Edit</a></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="admin-empty"><i class="fas fa-envelope-open"></i><h3>No templates found</h3><p>Default templates should be created during application startup.</p></div>
    }
</section>
