@model UpdateEmailTemplateDto
@{
    ViewData["Title"] = "ویرایش قالب ایمیل";
    Layout = "_AdminLayout";
}
<div class="card col-md-8">
    <div class="card-body">
        <h5 class="card-title">ویرایش قالب: @ViewData["Key"]</h5>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Body" class="form-label"></label>
                <textarea asp-for="Body" class="form-control" rows="5"></textarea>
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsEnabled" class="form-check-input" />
                <label asp-for="IsEnabled" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary"><i class="bi bi-save"></i> ذخیره</button>
        </form>
    </div>
</div>