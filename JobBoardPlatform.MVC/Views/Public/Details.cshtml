@model JobPostingPublicDto
@{ ViewData["Title"] = Model.Title; }
<div class="card">
    <div class="card-body">
        <h2>
            @Model.Title
            @if (Model.IsFeatured)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> ویژه</span>
            }
        </h2>
        <p class="text-muted">
            <i class="bi bi-building"></i> @Model.CompanyName
            &nbsp;|&nbsp; <i class="bi bi-geo-alt"></i> @Model.Location
            &nbsp;|&nbsp; <i class="bi bi-briefcase"></i> @Model.EmploymentType
        </p>
        <hr />
        <p>@Model.Description</p>
        <p><i class="bi bi-cash-coin"></i> <strong>حقوق:</strong> @Model.SalaryMin تا @Model.SalaryMax</p>
        <p><i class="bi bi-tag"></i> <strong>دسته‌بندی:</strong> @Model.Category</p>
        <p><i class="bi bi-stars"></i> <strong>مهارت‌ها:</strong> @Model.Skills</p>

        @if (User.IsInRole("JobSeeker"))
        {
            <form asp-controller="JobSeekerApplications" asp-action="Apply" method="post" class="mt-3">
                <input type="hidden" name="JobPostingId" value="@Model.Id" />
                <div class="mb-3">
                    <textarea name="CoverLetter" class="form-control" placeholder="متن معرفی (اختیاری)"></textarea>
                </div>
                <button class="btn btn-success"><i class="bi bi-send"></i> ارسال درخواست</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mt-3">برای ارسال درخواست وارد شوید</a>
        }
    </div>
</div>