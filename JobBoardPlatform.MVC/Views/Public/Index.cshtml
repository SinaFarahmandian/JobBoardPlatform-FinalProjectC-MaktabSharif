@model PagedResult<JobPostingPublicDto>
@{
    ViewData["Title"] = "آگهی‌های شغلی";
    var q = ViewData["Query"] as JobPostingSearchQueryDto;
}
<div class="p-4 mb-4 bg-primary bg-gradient text-white rounded-3">
    <h2><i class="bi bi-search"></i> فرصت‌های شغلی</h2>
    <p class="mb-0">بین آگهی‌های فعال بگرد و همین حالا درخواست بده</p>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3"><input name="Search" value="@q?.Search" class="form-control" placeholder="عنوان شغل" /></div>
    <div class="col-md-2"><input name="City" value="@q?.City" class="form-control" placeholder="شهر" /></div>
    <div class="col-md-2"><input name="Category" value="@q?.Category" class="form-control" placeholder="دسته‌بندی" /></div>
    <div class="col-md-2"><input name="Skill" value="@q?.Skill" class="form-control" placeholder="مهارت" /></div>
    <div class="col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-search"></i> جستجو</button></div>
</form>

@foreach (var job in Model.Items)
{
    <div class="card mb-3 @(job.IsFeatured ? "border-warning border-2" : "")">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5 class="card-title">
                    @job.Title
                    @if (job.IsFeatured)
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> ویژه</span>
                    }
                </h5>
            </div>
            <p class="text-muted mb-2">
                <i class="bi bi-building"></i> @job.CompanyName
                &nbsp;|&nbsp; <i class="bi bi-geo-alt"></i> @job.Location
                &nbsp;|&nbsp; <i class="bi bi-briefcase"></i> @job.EmploymentType
            </p>
            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">مشاهده جزئیات</a>
        </div>
    </div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info"><i class="bi bi-info-circle"></i> آگهی‌ای با این مشخصات پیدا نشد.</div>
}

<nav>
    <ul class="pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { Page = p, q?.Search, q?.City, q?.Category, q?.Skill })">@p</a>
            </li>
        }
    </ul>
</nav>