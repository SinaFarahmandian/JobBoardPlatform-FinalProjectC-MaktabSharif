@model JobBoardPlatform.Buisiness.Dtos.JobPosting.UpdateJobPostingDto
@{
    ViewData["Title"] = "Edit Job";
    ViewData["SubmitLabel"] = "Save Changes";
}
<div class="page-shell">
    <div class="container" style="max-width:980px">
        <div class="page-header"><div class="page-header-copy"><span class="eyebrow"><i class="fas fa-edit"></i> Update job opportunity</span><h1>Edit Job Posting</h1><p>Saved changes will appear on the public job page.</p></div><a asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left me-1"></i> Back</a></div>
        <section class="surface-card">
            <div class="surface-card-header"><h2><i class="fas fa-briefcase me-1 text-primary"></i> Job Details</h2></div>
            <div class="surface-card-body">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <form asp-action="Edit" asp-route-id="@ViewData["JobPostingId"]" method="post"><partial name="_JobPostingForm" model="Model" /></form>
            </div>
        </section>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
