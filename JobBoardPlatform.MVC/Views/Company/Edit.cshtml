@model JobBoardPlatform.Buisiness.Dtos.Company.UpdateCompanyDto
@{ ViewData["Title"] = "Edit Company"; }
<div class="page-shell">
    <div class="container" style="max-width:920px">
        <div class="page-header"><div class="page-header-copy"><h1>Edit Company Profile</h1><p>A complete profile builds candidate trust before they apply.</p></div><a asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left me-1"></i> Cancel</a></div>
        <section class="surface-card">
            <div class="surface-card-header"><h2><i class="fas fa-building me-1 text-primary"></i> General Information</h2></div>
            <div class="surface-card-body">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <form asp-action="Edit" method="post">
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Name" class="form-label">Company Name</label><input asp-for="Name" class="form-control" placeholder="Official name or company brand" /><span asp-validation-for="Name"></span></div>
                        <div class="col-md-6"><label asp-for="Industry" class="form-label">Industry</label><input asp-for="Industry" class="form-control" placeholder="For example, Information Technology" /><span asp-validation-for="Industry"></span></div>
                        <div class="col-12"><label asp-for="Website" class="form-label">Website</label><input asp-for="Website" class="form-control" placeholder="https://company.com" /><span asp-validation-for="Website"></span></div>
                        <div class="col-12"><label asp-for="Description" class="form-label">Company Description</label><textarea asp-for="Description" class="form-control" rows="6" placeholder="Describe your product, team, culture, and mission..."></textarea><span asp-validation-for="Description"></span><div class="form-text">A clear, authentic description of three to five paragraphs works best.</div></div>
                    </div>
                    <div class="d-flex gap-2 mt-4 pt-3 border-top"><button class="btn btn-primary px-4" type="submit"><i class="fas fa-save me-1"></i> Save Changes</button><a asp-action="Index" class="btn btn-ghost">Back</a></div>
                </form>
            </div>
        </section>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
