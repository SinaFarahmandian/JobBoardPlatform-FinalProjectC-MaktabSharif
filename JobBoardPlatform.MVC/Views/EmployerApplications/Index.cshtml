@model List<JobApplicationDto>
@{
    ViewData["Title"] = "درخواست‌های آگهی";
    string BadgeClass(string status) => status switch
    {
        "Pending" => "bg-secondary",
        "Reviewing" => "bg-info",
        "Interview" => "bg-primary",
        "Accepted" => "bg-success",
        "Rejected" => "bg-danger",
        "Cancelled" => "bg-dark",
        _ => "bg-secondary"
    };
}
<h2><i class="bi bi-inbox"></i> درخواست‌های دریافتی</h2>
<div class="card">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr><th>کارجو</th><th>وضعیت</th><th>تاریخ</th><th></th></tr></thead>
            <tbody>
            @foreach (var app in Model)
            {
                <tr>
                    <td>@app.JobSeekerName</td>
                    <td><span class="badge @BadgeClass(app.Status)">@app.Status</span></td>
                    <td>@app.AppliedAt.ToString("yyyy/MM/dd")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i> جزئیات</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>