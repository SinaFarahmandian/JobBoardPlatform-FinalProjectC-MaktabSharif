@model List<JobApplicationDto>
@{
    ViewData["Title"] = "Received Applications";
    var jobPostingId = ViewData["JobPostingId"];
    string BadgeClass(string status) => status switch { "Pending" => "badge-warning", "Reviewing" => "badge-info", "Interview" => "badge-primary", "Accepted" => "badge-success", "Rejected" => "badge-danger", "Cancelled" => "badge-neutral", _ => "badge-neutral" };
    string StatusLabel(string status) => status switch { "Pending" => "New", "Reviewing" => "Under Review", "Interview" => "Interview", "Accepted" => "Accepted", "Rejected" => "Rejected", "Cancelled" => "Withdrawn", _ => status };
}
<div class="page-shell">
    <div class="container">
        <div class="page-header">
            <div class="page-header-copy"><span class="eyebrow"><i class="fas fa-users"></i> Hiring pipeline</span><h1>Received Applications</h1><p>@Model.Count applications have been submitted for this job.</p></div>
            <a asp-controller="EmployerJobPostings" asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left me-1"></i> Back to Jobs</a>
        </div>
        @if (Model.Any())
        {
            <section class="surface-card">
                <div class="surface-card-header"><h2>Candidates</h2><span class="badge-soft badge-info">@Model.Count applications</span></div>
                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead><tr><th>Candidate</th><th>Status</th><th>Applied</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var app in Model)
                        {
                            var initial = string.IsNullOrWhiteSpace(app.JobSeekerName) ? "C" : app.JobSeekerName.Trim().Substring(0, 1);
                            <tr>
                                <td><div class="table-primary-cell"><span class="table-icon">@initial</span><span class="table-primary-copy"><strong>@app.JobSeekerName</strong><small>@app.JobPostingTitle</small></span></div></td>
                                <td><span class="badge-soft @BadgeClass(app.Status)">@StatusLabel(app.Status)</span></td>
                                <td>@app.AppliedAt.ToString("MMM d, yyyy")</td>
                                <td><div class="table-actions"><a asp-action="Details" asp-route-id="@app.Id" class="btn btn-soft-primary"><i class="fas fa-eye me-1"></i> Review Application</a></div></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
            <div class="empty-state"><span class="empty-state-icon"><i class="fas fa-inbox"></i></span><h3>No applications yet</h3><p>Complete the job description and keep the posting active to improve its visibility.</p><a asp-controller="EmployerJobPostings" asp-action="Edit" asp-route-id="@jobPostingId" class="btn btn-primary">Edit Job</a></div>
        }
    </div>
</div>
