@model JobBoardPlatform.MVC.Models.Account.RegisterJobSeekerViewModel
@{
    ViewData["Title"] = "Job Seeker Registration";
    ViewData["BodyClass"] = "auth-page";
}
<section class="auth-section">
    <div class="container">
        <div class="auth-layout">
            <aside class="auth-aside">
                <a class="brand" asp-controller="Public" asp-action="Index"><span class="brand-mark"><i class="fas fa-briefcase"></i></span><span>Career<span>Way</span></span></a>
                <div class="auth-pitch">
                    <h2>Better opportunities begin with a strong introduction.</h2>
                    <p>Create your job seeker profile and follow every application with confidence.</p>
                    <div class="auth-points">
                        <span class="auth-point"><i class="fas fa-file-pdf"></i> Secure PDF resume storage</span>
                        <span class="auth-point"><i class="fas fa-bell"></i> Application status updates</span>
                        <span class="auth-point"><i class="fas fa-tasks"></i> Every application in one place</span>
                    </div>
                </div>
                <div class="auth-quote">Creating an account is free and takes less than two minutes.</div>
            </aside>

            <div class="auth-card">
                <div class="auth-card-head">
                    <h1>Create a Job Seeker Account</h1>
                    <p>Enter the basics now. You can complete your career profile later.</p>
                </div>
                <div class="role-switch">
                    <a class="active" asp-action="RegisterJobSeeker"><i class="fas fa-user me-1"></i> I'm a Job Seeker</a>
                    <a asp-action="RegisterEmployer"><i class="fas fa-building me-1"></i> I'm an Employer</a>
                </div>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <form asp-action="RegisterJobSeeker" method="post">
                    <div class="form-group">
                        <label asp-for="FullName" class="form-label"></label>
                        <div class="field-icon"><i class="fas fa-user"></i><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="First and last name" /></div>
                        <span asp-validation-for="FullName"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="field-icon"><i class="fas fa-envelope"></i><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" dir="ltr" /></div>
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="field-icon has-toggle">
                            <i class="fas fa-lock"></i><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" />
                            <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password"></span>
                        <div class="form-text">Use at least one uppercase letter, one lowercase letter, and one number.</div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-submit"><i class="fas fa-user-plus me-1"></i> Create Free Account</button>
                </form>
                <div class="auth-switch">Already have an account? <a asp-action="Login">Sign in</a>.</div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
