@model JobBoardPlatform.MVC.Models.Account.RegisterEmployerViewModel
@{
    ViewData["Title"] = "Employer Registration";
    ViewData["BodyClass"] = "auth-page";
}
<section class="auth-section">
    <div class="container">
        <div class="auth-layout">
            <aside class="auth-aside">
                <a class="brand" asp-controller="Public" asp-action="Index"><span class="brand-mark"><i class="fas fa-briefcase"></i></span><span>Career<span>Way</span></span></a>
                <div class="auth-pitch">
                    <h2>Build a better team with a better hiring experience.</h2>
                    <p>Publish jobs, move applications through each stage, and communicate clearly with candidates.</p>
                    <div class="auth-points">
                        <span class="auth-point"><i class="fas fa-bullhorn"></i> Publish and manage job postings</span>
                        <span class="auth-point"><i class="fas fa-users"></i> Review applications in one place</span>
                        <span class="auth-point"><i class="fas fa-envelope-open-text"></i> Professional automated notifications</span>
                    </div>
                </div>
                <div class="auth-quote">Employer accounts are activated after an administrator review.</div>
            </aside>

            <div class="auth-card">
                <div class="auth-card-head">
                    <h1>Register Your Company</h1>
                    <p>Create an employer account and company profile at the same time.</p>
                </div>
                <div class="role-switch">
                    <a asp-action="RegisterJobSeeker"><i class="fas fa-user me-1"></i> I'm a Job Seeker</a>
                    <a class="active" asp-action="RegisterEmployer"><i class="fas fa-building me-1"></i> I'm an Employer</a>
                </div>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <form asp-action="RegisterEmployer" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <div class="field-icon"><i class="fas fa-user"></i><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="First and last name" /></div>
                            <span asp-validation-for="FullName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <div class="field-icon"><i class="fas fa-building"></i><input asp-for="CompanyName" class="form-control" placeholder="Company name" /></div>
                            <span asp-validation-for="CompanyName"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <div class="field-icon"><i class="fas fa-envelope"></i><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@company.com" dir="ltr" /></div>
                            <span asp-validation-for="Email"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="CompanyWebsite" class="form-label"></label>
                            <div class="field-icon"><i class="fas fa-globe"></i><input asp-for="CompanyWebsite" class="form-control" placeholder="https://company.com" dir="ltr" /></div>
                            <span asp-validation-for="CompanyWebsite"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="field-icon has-toggle">
                                <i class="fas fa-lock"></i><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" />
                                <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password"><i class="fas fa-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-submit"><i class="fas fa-building me-1"></i> Register Company</button>
                </form>
                <div class="auth-switch">Already have an employer account? <a asp-action="Login">Sign in</a>.</div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
