@model JobBoardPlatform.MVC.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["BodyClass"] = "auth-page";
}
<section class="auth-section">
    <div class="container">
        <div class="auth-layout">
            <aside class="auth-aside">
                <a class="brand" asp-controller="Public" asp-action="Index">
                    <span class="brand-mark"><i class="fas fa-briefcase"></i></span><span>Career<span>Way</span></span>
                </a>
                <div class="auth-pitch">
                    <h2>Continue your career journey right where you left off.</h2>
                    <p>Your opportunities, applications, and career information live together in one simple, secure place.</p>
                    <div class="auth-points">
                        <span class="auth-point"><i class="fas fa-search"></i> Focused search across trusted jobs</span>
                        <span class="auth-point"><i class="fas fa-paper-plane"></i> Submit and track applications</span>
                        <span class="auth-point"><i class="fas fa-shield-alt"></i> Secure, role-based access</span>
                    </div>
                </div>
                <div class="auth-quote">“The right opportunity is often one step beyond the decision to begin again.”</div>
            </aside>

            <div class="auth-card">
                <div class="auth-card-head">
                    <h1>Welcome back 👋</h1>
                    <p>Enter your details to sign in to CareerWay.</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div class="form-group">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="field-icon"><i class="fas fa-envelope"></i><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" dir="ltr" /></div>
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="field-icon has-toggle">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
                            <button type="button" class="password-toggle" data-password-toggle="Password" aria-label="Show password"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div class="auth-options">
                        <label class="form-check d-flex align-items-center gap-2 m-0">
                            <input asp-for="RememberMe" class="form-check-input m-0" />
                            <span>Remember me</span>
                        </label>
                        <span class="text-muted">Secure sign-in with encrypted data</span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-submit"><i class="fas fa-sign-in-alt me-1"></i> Sign In to CareerWay</button>
                </form>

                <div class="auth-switch">New to CareerWay? <a asp-action="RegisterJobSeeker">Create a job seeker account</a> or <a asp-action="RegisterEmployer">register as an employer</a>.</div>
            </div>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
