@{
    ViewData["Title"] = "Privacy";
}
<div class="page-shell">
    <div class="container" style="max-width:900px">
        <div class="page-header">
            <div class="page-header-copy">
                <span class="eyebrow"><i class="fas fa-shield-alt"></i> Your trust matters to us</span>
                <h1>Privacy at CareerWay</h1>
                <p>Transparency about the information we retain to provide a better service.</p>
            </div>
        </div>
        <article class="surface-card surface-card-body prose">
            <h2>Account Information</h2>
            <p>Identity and career information is used only to create your account, display your profile, and connect job seekers with employers.</p>
            <h2>Resumes and Job Applications</h2>
            <p>Your resume and cover letter are available only within your job applications and to the relevant employer.</p>
            <h2>Data Security and Retention</h2>
            <p>CareerWay protects data with role-based access control, request validation, and established platform security standards.</p>
            <h2>Contact Us</h2>
            <p>For questions about your account data, contact <a href="mailto:support@careerway.local">CareerWay Support</a>.</p>
        </article>
    </div>
</div>
