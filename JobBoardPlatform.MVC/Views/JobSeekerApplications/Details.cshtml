@model JobSeekerApplicationDto
@{
    ViewData["Title"] = "Application Details";
    string StatusLabel(string status) => status switch { "Pending" => "Submitted", "Reviewing" => "Under Review", "Interview" => "Interview", "Accepted" => "Accepted", "Rejected" => "Rejected", "Cancelled" => "Withdrawn", _ => status };
    string BadgeClass(string status) => status switch { "Pending" => "badge-warning", "Reviewing" => "badge-info", "Interview" => "badge-primary", "Accepted" => "badge-success", "Rejected" => "badge-danger", _ => "badge-neutral" };
    var isClosed = Model.Status is "Accepted" or "Rejected" or "Cancelled";
}
<div class="page-shell">
    <div class="container" style="max-width:900px">
        <div class="page-header"><div class="page-header-copy"><h1>Application Details</h1><p>The latest status of your application for this opportunity.</p></div><a asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left me-1"></i> Back</a></div>
        <section class="surface-card application-detail">
            <div class="application-head">
                <span class="application-head-icon"><i class="fas fa-briefcase"></i></span>
                <div class="flex-grow-1"><h2>@Model.JobPostingTitle</h2><p>@Model.CompanyName · Submitted on @Model.AppliedAt.ToString("MMM d, yyyy")</p></div>
                <span class="badge-soft @BadgeClass(Model.Status)">@StatusLabel(Model.Status)</span>
            </div>

            <div class="status-stepper" aria-label="Application progress">
                <div class="status-step is-done"><span class="status-dot"><i class="fas fa-check"></i></span><span class="status-line"></span></div>
                <div class="status-step @(Model.Status is not "Pending" and not "Cancelled" ? "is-done" : Model.Status == "Pending" ? "is-current" : "")"><span class="status-dot"><i class="fas fa-search"></i></span><span class="status-line"></span></div>
                <div class="status-step @(Model.Status is "Interview" or "Accepted" or "Rejected" ? "is-done" : "")"><span class="status-dot"><i class="fas fa-comments"></i></span><span class="status-line"></span></div>
                <div class="status-step @(isClosed ? "is-current" : "")"><span class="status-dot"><i class="fas fa-flag-checkered"></i></span></div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6"><div class="info-row"><span class="info-row-label"><i class="fas fa-building"></i> Company</span><strong>@Model.CompanyName</strong></div></div>
                <div class="col-md-6"><div class="info-row"><span class="info-row-label"><i class="fas fa-calendar"></i> Submitted</span><strong>@Model.AppliedAt.ToString("MMM d, yyyy")</strong></div></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                <a asp-controller="Public" asp-action="Details" asp-route-id="@Model.JobPostingId" class="btn btn-soft-primary">View Job</a>
                @if (Model.Status == "Pending")
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" data-confirm="Withdraw this application?"><button type="submit" class="btn btn-soft-danger">Withdraw Application</button></form>
                }
            </div>
        </section>
    </div>
</div>
