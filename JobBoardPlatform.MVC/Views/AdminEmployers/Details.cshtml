@model EmployerAdminDetailsDto
@{
    ViewData["Title"] = "Employer Details";
    Layout = "_AdminLayout";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "E" : Model.FullName.Trim().Substring(0, 1);
    var status = Model.IsApproved && Model.IsActive ? "Approved" : !Model.IsApproved && Model.IsActive ? "Pending Approval" : "Rejected or Inactive";
}
<div class="admin-page-head"><div><h1>Employer Details</h1><p>Review account and company information before deciding on access.</p></div><a asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left me-1"></i> Back</a></div>
<div class="admin-detail-grid">
    <div>
        <section class="admin-profile-card mb-3"><div class="admin-profile-head"><span class="admin-profile-avatar">@initial</span><div><h2>@Model.FullName</h2><p>@Model.CompanyName · @status</p></div></div></section>
        <section class="admin-card">
            <div class="admin-card-head"><div><h2>Account and Company Information</h2><p>Information provided by the employer</p></div></div>
            <div class="admin-card-body">
                <div class="admin-detail-list">
                    <div class="admin-detail-item"><small>Email</small><strong>@Model.Email</strong></div>
                    <div class="admin-detail-item"><small>Company Name</small><strong>@Model.CompanyName</strong></div>
                    <div class="admin-detail-item"><small>Industry</small><strong>@(Model.Industry ?? "Not provided")</strong></div>
                    <div class="admin-detail-item"><small>Job Postings</small><strong>@Model.JobPostingsCount</strong></div>
                    <div class="admin-detail-item"><small>Joined</small><strong>@Model.CreatedAt.ToString("MMM d, yyyy")</strong></div>
                    <div class="admin-detail-item"><small>Website</small>@if (!string.IsNullOrWhiteSpace(Model.CompanyWebsite)) { <a href="@Model.CompanyWebsite" target="_blank" rel="noopener noreferrer">@Model.CompanyWebsite</a> } else { <strong>Not provided</strong> }</div>
                </div>
                <h3 class="h6 fw-bold mt-4 mb-2">Company Description</h3><div class="admin-long-copy">@(Model.CompanyDescription ?? "No description has been provided.")</div>
            </div>
        </section>
    </div>
    <aside class="admin-card">
        <div class="admin-card-head"><div><h2>Access Management</h2><p>Current status: @status</p></div></div>
        <div class="admin-card-body">
            @if (!Model.IsApproved)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="mb-2" data-confirm="Approve this employer account?"><button class="btn btn-success w-100" type="submit"><i class="fas fa-check me-1"></i> Approve and Activate</button></form>
            }
            @if (Model.IsApproved || Model.IsActive)
            {
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" data-confirm="Reject or deactivate this employer's access?"><button class="btn btn-soft-danger w-100" type="submit"><i class="fas fa-ban me-1"></i> Reject or Revoke Access</button></form>
            }
            <p class="text-muted mt-3 mb-0" style="font-size:.64rem">The employer will be notified of the decision by email.</p>
        </div>
    </aside>
</div>
