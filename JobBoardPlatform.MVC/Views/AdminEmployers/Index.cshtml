@model List<EmployerAdminDto>
@{
    ViewData["Title"] = "مدیریت کارفرماها";
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr><th>نام</th><th>شرکت</th><th>وضعیت تأیید</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.FullName</td>
                    <td>@e.CompanyName</td>
                    <td>
                        @if (e.IsApproved)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> تأییدشده</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> در انتظار</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        <form asp-action="Approve" asp-route-id="@e.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> تأیید</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@e.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-danger"><i class="bi bi-x-lg"></i> رد</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>