@model JobBoardPlatform.Buisiness.Dtos.JobSeekerProfile.UpdateJobSeekerProfileDto
@{ ViewData["Title"] = "ویرایش پروفایل"; }
<h2>ویرایش پروفایل</h2>
<form asp-action="Edit" method="post" class="col-md-6">
    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Skills" class="form-label"></label><input asp-for="Skills" class="form-control" /></div>
    <div class="mb-3"><label asp-for="YearsOfExperience" class="form-label"></label><input asp-for="YearsOfExperience" class="form-control" /></div>
    <div class="mb-3"><label asp-for="DesiredJobTitle" class="form-label"></label><input asp-for="DesiredJobTitle" class="form-control" /></div>
    <button class="btn btn-primary">ذخیره</button>
</form>