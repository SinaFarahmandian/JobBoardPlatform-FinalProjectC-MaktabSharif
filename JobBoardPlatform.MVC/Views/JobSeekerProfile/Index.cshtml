@model JobSeekerProfileDto
@{
    ViewData["Title"] = "Career Profile";
    var completed = 2 + (!string.IsNullOrWhiteSpace(Model.PhoneNumber) ? 1 : 0)
                    + (!string.IsNullOrWhiteSpace(Model.Skills) ? 1 : 0)
                    + (!string.IsNullOrWhiteSpace(Model.DesiredJobTitle) ? 1 : 0)
                    + (Model.HasResume ? 1 : 0);
    var completion = (int)Math.Round(completed / 6d * 100);
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Trim().Substring(0, 1);
}
<div class="page-shell">
    <div class="container">
        <div class="page-header">
            <div class="page-header-copy">
                <span class="eyebrow"><i class="fas fa-user-check"></i> Your professional showcase</span>
                <h1>My Profile</h1>
                <p>The career information and resume you use when applying for jobs.</p>
            </div>
            <div class="page-actions">
                <a asp-action="Edit" class="btn btn-primary"><i class="fas fa-pen me-1"></i> Edit Profile</a>
            </div>
        </div>

        <div class="dashboard-grid">
            <section class="surface-card span-7">
                <div class="profile-hero">
                    <span class="profile-avatar">@initial</span>
                    <div class="profile-copy">
                        <h2>@Model.FullName</h2>
                        <p>@(string.IsNullOrWhiteSpace(Model.DesiredJobTitle) ? "Add your desired job title" : Model.DesiredJobTitle)</p>
                        <div class="profile-progress">
                            <div class="profile-progress-head"><span>Profile completion</span><strong>@completion%</strong></div>
                            <div class="progress" role="progressbar" aria-label="Profile completion percentage" aria-valuenow="@completion" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@completion%"></div></div>
                        </div>
                    </div>
                </div>
                <div class="surface-card-body pt-0">
                    <div class="info-list">
                        <div class="info-row"><span class="info-row-label"><i class="fas fa-envelope"></i> Email</span><strong>@Model.Email</strong></div>
                        <div class="info-row"><span class="info-row-label"><i class="fas fa-phone"></i> Phone</span><strong>@(Model.PhoneNumber ?? "Not provided")</strong></div>
                        <div class="info-row"><span class="info-row-label"><i class="fas fa-briefcase"></i> Experience</span><strong>@Model.YearsOfExperience years</strong></div>
                        <div class="info-row"><span class="info-row-label"><i class="fas fa-code"></i> Skills</span><strong>@(Model.Skills ?? "Not provided")</strong></div>
                    </div>
                </div>
            </section>

            <section class="surface-card span-5 resume-card">
                <div class="surface-card-header"><h2><i class="fas fa-file-alt me-1 text-primary"></i> My Resume</h2></div>
                <div class="surface-card-body">
                    @if (Model.HasResume)
                    {
                        <div class="resume-status">
                            <i class="fas fa-file-pdf"></i>
                            <span class="resume-status-copy"><strong>@Model.ResumeFileName</strong><small>Your resume is ready to send</small></span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="DownloadResume" class="btn btn-soft-primary flex-grow-1"><i class="fas fa-download me-1"></i> Download</a>
                            <form asp-action="DeleteResume" method="post" data-confirm="Delete your current resume?">
                                <button type="submit" class="btn btn-soft-danger btn-icon" aria-label="Delete resume"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state border-0 p-3">
                            <span class="empty-state-icon"><i class="fas fa-file-upload"></i></span>
                            <h3>You have not uploaded a resume yet</h3>
                            <p>Add a PDF file up to 5 MB.</p>
                        </div>
                    }

                    <form asp-action="UploadResume" method="post" enctype="multipart/form-data" class="mt-3">
                        <div class="file-drop">
                            <input id="resumeFile" type="file" name="file" accept="application/pdf,.pdf" required data-file-input="resumeFileName" />
                            <i class="fas fa-cloud-upload-alt"></i>
                            <strong id="resumeFileName">Choose a resume file</strong>
                            <small>PDF · 5 MB maximum</small>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2"><i class="fas fa-upload me-1"></i> @(Model.HasResume ? "Replace Resume" : "Upload Resume")</button>
                    </form>
                </div>
            </section>

            <section class="surface-card span-12">
                <div class="surface-card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h3 class="h6 fw-bold mb-1">Track your job applications</h3>
                        <p class="text-muted small mb-0">Review, interview, and outcome updates in one place.</p>
                    </div>
                    <a asp-controller="JobSeekerApplications" asp-action="Index" class="btn btn-soft-primary">View My Applications <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </section>
        </div>
    </div>
</div>
